# direnv: `direnv allow` once, then every mvn/java in this tree uses the JBR.
#
# Canonical path (after `gmake images` in the JBR build):
#   export JAVA_HOME=/Users/minamoto/ws/github/jbr/build/macosx-aarch64-server-release/images/jdk
#
# Until `gmake images` is run, the exploded build is a fully functional, JVMCI-enabled
# JDK and is used here:
export JAVA_HOME=/Users/minamoto/ws/github/jbr/build/macosx-aarch64-server-release/jdk
export PATH="$JAVA_HOME/bin:$PATH"