<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jetbrains.hexana</groupId>
        <artifactId>interpreter-jit-experiment</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hexana-specializer</artifactId>
    <packaging>jar</packaging>
    <name>Interpreter JIT Experiment :: specializer (bytecode agent)</name>
    <description>
        A -javaagent that transparently specializes Interpreter.run to the fixed program: it
        injects (via ASM) a guarded fast path that runs the partial-evaluated computation, which
        C2 then JITs to the specialization ceiling. No application source change. This is the
        feasible, safe alternative to hand-written JVMCI codegen — the JIT does the codegen for us
        on bytecode that's trivially correct.
    </description>

    <properties>
        <asm.version>9.7.1</asm.version>
        <agent.name>hexana-specializer</agent.name>
    </properties>

    <dependencies>
        <!-- For ProgramBuilder/BenchState (the known program + its constants). Provided at
             runtime by the benchmark JVM's classpath, so not shaded into the agent. -->
        <dependency>
            <groupId>org.jetbrains.hexana</groupId>
            <artifactId>bench</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>${asm.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!-- Build the agent jar: bundle ASM, set Premain-Class. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-agent-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${agent.name}</finalName>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>org.jetbrains.hexana.specializer.Premain</Premain-Class>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>